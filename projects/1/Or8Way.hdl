CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    Or(a=in[0] , b=in[1] , out=pair1 );
    Or(a=in[2] , b=in[3] , out=pair2 );
    Or(a=in[4] , b=in[5] , out=pair3 );
    Or(a=in[6] , b=in[7] , out=pair4 );
    Or(a=pair1 , b=pair2 , out=pair12 );
    Or(a=pair3 , b=pair4 , out=pair34 );
    Or(a=pair12 , b=pair34 , out=out );


}